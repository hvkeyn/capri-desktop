{
  "name": "capri-desktop",
  "version": "0.11.2",
  "description": "Capri, the Project Capricorn construct, living on your desktop and narrating what Claude Code is doing.",
  "author": "mochiiwuff",
  "repository": "github:hvkeyn/capri-desktop",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "demo": "node scripts/demo.js",
    "hooks:install": "node scripts/install-hooks.js",
    "hooks:uninstall": "node scripts/install-hooks.js --uninstall",
    "hooks:codex:install": "node scripts/install-codex-hooks.js",
    "hooks:codex:uninstall": "node scripts/install-codex-hooks.js --uninstall",
    "hooks:agy:install": "node scripts/install-hooks-agy.js",
    "hooks:agy:uninstall": "node scripts/install-hooks-agy.js --uninstall",
    "check:llm": "node scripts/check-llm.js",
    "check:deepseek": "node scripts/check-deepseek.js",
    "check:tools": "node scripts/check-tools.js",
    "test": "node --test tests/agent.test.js tests/board.test.js tests/tools.test.js tests/update.test.js tests/secrets.test.js tests/config.test.js tests/activity.test.js tests/panel.test.js tests/answer.test.js tests/tools-extra.test.js tests/fss.test.js tests/ocr.test.js tests/lines.test.js tests/rotation.test.js tests/composer.test.js tests/hooks.test.js",
    "smoke": "node scripts/smoke.js",
    "check:secrets": "node scripts/check-secrets.js --all",
    "hooks:secrets": "git config core.hooksPath .githooks",
    "try": "node scripts/try-work.js",
    "test:hooks": "node --test tests/hooks.test.js",
    "dist": "electron-builder --win"
  },
  "keywords": [
    "claude-code",
    "desktop-pet",
    "electron",
    "cyberpunk",
    "edgerunners"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0"
  },
  "build": {
    "appId": "capri.desktop",
    "productName": "Capri",
    "files": [
      "src/**",
      "assets/**",
      "harness/**",
      "hooks/**",
      "scripts/**",
      "package.json",
      "LICENSE"
    ],
    "asarUnpack": [
      "hooks/**",
      "src/main/windows.ps1",
      "src/main/ocr.ps1"
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "assets/icons/capri.ico"
    },
    "portable": {
      "artifactName": "Capri-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "Capri",
      "artifactName": "Capri-Setup-${version}.${ext}"
    }
  }
}
