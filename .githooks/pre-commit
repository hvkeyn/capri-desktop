#!/bin/sh
# Refuse a commit that carries a key, a token, a private key, or a path with your own name in it.
# Installed by `npm run hooks:secrets` (git config core.hooksPath .githooks).
root=$(git rev-parse --show-toplevel) || exit 0
command -v node >/dev/null 2>&1 || exit 0
exec node "$root/scripts/check-secrets.js"